# Copy to .env and fill real values. Never commit .env.
NODE_ENV=production
LOG_LEVEL=info
APP_PORT=3000

POSTGRES_USER=comsync
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=comsync

# Local dev direct connection (compose overrides this internally for the app service)
DATABASE_URL=postgres://comsync:change-me-strong-password@localhost:5432/comsync

APP_IMAGE=comsync-task-api
APP_IMAGE_TAG=local
